# BorderWise AI - Environment Configuration Example
# Copy to .env for local development

# Application Mode & Core Settings
APP_NAME="BorderWise AI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# CORS (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (SQLite for local MVP)
DATABASE_URL="sqlite:///./borderwise.db"

# Optional AI Copilot Integration (Leave empty to use deterministic mock/heuristic fallback)
# Application runs 100% locally and reliably without any API keys.
LLM_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
